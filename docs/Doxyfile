# https://www.doxygen.nl/manual/config.html
PROJECT_NAME = CATChem
PROJECT_BRIEF =

OPTIMIZE_FOR_FORTRAN = YES

INPUT = doxygen/index.md \
        ../src/core \
        ../src/process \
        ../src/api
EXCLUDE_PATTERNS = */external/*
EXCLUDE = ../src/api/catchem_musica_registration.cpp
USE_MDFILE_AS_MAINPAGE = doxygen/index.md
FILE_PATTERNS = *.F90 *.hpp *.cpp
RECURSIVE = YES

WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES

# Doxygen Awesome
HTML_EXTRA_STYLESHEET = tweaks.css
HTML_COLORSTYLE = LIGHT

# Doxysphinx required
GENERATE_TREEVIEW = NO
DISABLE_INDEX = NO
GENERATE_HTML = YES
CREATE_SUBDIRS = NO
OUTPUT_DIRECTORY = ./doxygen/
GENERATE_LATEX = NO

# Doxysphinx recommended
SEARCHENGINE = NO
GENERATE_TAGFILE = ./doxygen/html/tagfile.xml
DOT_IMAGE_FORMAT = svg
INTERACTIVE_SVG = YES
ALIASES = "rst=\verbatim embed:rst:leading-asterisk" \
          endrst=\endverbatim

# GraphViz Configuration
INCLUDE_GRAPH = NO
INCLUDED_BY_GRAPH = NO
CALL_GRAPH = YES
