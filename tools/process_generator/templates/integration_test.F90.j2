{%- set sep.value = '\n            ' %}
{%- endif %}
{%- if required_met_fields and 'PS' in required_met_fields %}
{{- sep.value -}} met_state%PS(i,j) = 1013.25_fp                     ! Surface pressure [hPa]
{%- set sep.value = '\n            ' %}
{%- endif %}
{%- if required_met_fields and 'SLP' in required_met_fields %}
{{- sep.value -}} met_state%SLP(i,j) = 1013.25_fp                    ! Sea level pressure [hPa]
{%- set sep.value = '\n            ' %}
{%- endif %}
{%- if required_met_fields and 'PS_WET' in required_met_fields %}
{{- sep.value -}} met_state%PS_WET(i,j) = 1013.25_fp                 ! Wet surface pressure [hPa]
{%- set sep.value = '\n            ' %}
{%- endif %}
{%- if required_met_fields and 'PS_DRY' in required_met_fields %}
