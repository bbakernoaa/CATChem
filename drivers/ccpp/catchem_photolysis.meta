[ccpp-table-properties]
  name = catchem_photolysis_driver
  type = scheme
  dependencies = catchem_ccpp_adapter.F90, catchem_ccpp_context.F90, catchem_ccpp_conversion.F90, catchem_ccpp_lifecycle.F90

[ccpp-arg-table]
  name = catchem_photolysis_driver_register
  type = scheme
[context_id]
  standard_name = catchem_context_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[context_generation]
  standard_name = catchem_context_generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[constituent_props]
  standard_name = ccpp_constituent_properties
  units = none
  dimensions = (number_of_ccpp_constituents)
  type = ccpp_constituent_properties_t
  allocatable = True
  intent = out
[errmsg]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character | kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out

[ccpp-arg-table]
  name = catchem_photolysis_driver_init
  type = scheme
[context_id]
  standard_name = catchem_context_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[context_generation]
  standard_name = catchem_context_generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[constituent_properties]
  standard_name = ccpp_constituent_properties
  units = none
  dimensions = (number_of_ccpp_constituents)
  type = ccpp_constituent_prop_ptr_t
  intent = in
[errmsg]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character | kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out

[ccpp-arg-table]
  name = catchem_photolysis_driver_run
  type = scheme
[context_id]
  standard_name = catchem_context_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[context_generation]
  standard_name = catchem_context_generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[interval_id]
  standard_name = catchem_interval_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[interval_token]
  standard_name = catchem_interval_token
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[site]
  standard_name = catchem_coupling_site
  units = none
  dimensions = ()
  type = character | kind = len=*
  intent = in
[subcycle]
  standard_name = catchem_process_subcycle
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[loop_counter]
  standard_name = ccpp_loop_counter
  units = index
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[loop_extent]
  standard_name = ccpp_loop_extent
  units = count
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[duration_seconds]
  standard_name = timestep_for_physics
  units = s
  dimensions = ()
  type = real | kind = kind_phys
  intent = in
[constituents]
  standard_name = ccpp_constituents
  units = none
  dimensions = (horizontal_dimension,vertical_layer_dimension,number_of_ccpp_constituents)
  type = real | kind = kind_phys
  intent = in
[air_pressure]
  standard_name = air_pressure
  units = Pa
  dimensions = (horizontal_dimension,vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = in
[air_temperature]
  standard_name = air_temperature
  units = K
  dimensions = (horizontal_dimension,vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = in
[specific_humidity]
  standard_name = specific_humidity
  units = kg kg-1
  dimensions = (horizontal_dimension,vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = in
[pedge]
  standard_name = air_pressure_at_interface
  units = Pa
  dimensions = (horizontal_dimension,vertical_interface_dimension)
  type = real | kind = kind_phys
  intent = in
[geopotential_interface]
  standard_name = geopotential_at_interface
  units = m2 s-2
  dimensions = (horizontal_dimension,vertical_interface_dimension)
  type = real | kind = kind_phys
  intent = in
[cloud_fraction]
  standard_name = instantaneous_3d_cloud_fraction
  units = frac
  dimensions = (horizontal_dimension,adjusted_vertical_layer_dimension_for_radiation)
  type = real | kind = kind_phys
  intent = in
[latitude]
  standard_name = latitude_in_degree
  units = degree_north
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[longitude]
  standard_name = longitude_in_degree
  units = degree_east
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[pbl_height]
  standard_name = atmosphere_boundary_layer_thickness
  units = m
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[ustar]
  standard_name = surface_friction_velocity
  units = m s-1
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[u10m]
  standard_name = x_wind_at_10m
  units = m s-1
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[v10m]
  standard_name = y_wind_at_10m
  units = m s-1
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[lwi]
  standard_name = sea_land_ice_mask
  units = flag
  dimensions = (horizontal_dimension)
  type = integer
  intent = in
[z0]
  standard_name = surface_roughness_length
  units = cm
  dimensions = (horizontal_dimension)
  type = real | kind = kind_phys
  intent = in
[errmsg]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character | kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out

[ccpp-arg-table]
  name = catchem_photolysis_driver_final
  type = scheme
[context_id]
  standard_name = catchem_context_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[context_generation]
  standard_name = catchem_context_generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[errmsg]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character | kind = len=*
  intent = out
[errflg]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out
