[ccpp-table-properties]
  name = catchem_apply_tendency
  type = scheme
  dependencies = catchem_ccpp_adapter.F90

[ccpp-arg-table]
  name = catchem_apply_tendency_run
  type = scheme
[context_id]
  standard_name = catchem_context_id
  units = 1
  dimensions = ()
  type = integer | kind = c_int
  intent = in
[context_generation]
  standard_name = catchem_context_generation
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[interval_token]
  standard_name = catchem_interval_token
  units = 1
  dimensions = ()
  type = integer | kind = c_int64_t
  intent = in
[loop_counter]
  standard_name = ccpp_loop_counter
  units = index
  dimensions = ()
  type = integer
  intent = in
[loop_extent]
  standard_name = ccpp_loop_extent
  units = count
  dimensions = ()
  type = integer
  intent = in
[duration_seconds]
  standard_name = timestep_for_physics
  units = s
  dimensions = ()
  type = real | kind = kind_phys
  intent = in
[constituents]
  standard_name = ccpp_constituents
  units = none
  dimensions = (horizontal_dimension, vertical_layer_dimension, number_of_ccpp_constituents)
  type = real | kind = kind_phys
  intent = inout
[constituent_tendencies]
  standard_name = ccpp_constituent_tendencies
  units = none
  dimensions = (horizontal_dimension, vertical_layer_dimension, number_of_ccpp_constituents)
  type = real | kind = kind_phys
  intent = inout
[errmsg]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = out
[errflg]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out
