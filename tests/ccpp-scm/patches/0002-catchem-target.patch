@@ -281,3 +281,87 @@ endif()

+if(CATCHEM_BUILD_MUSICA OR (DEFINED CATCHEM_CCPP_PROCESSES AND CATCHEM_CCPP_PROCESSES MATCHES "photolysis|gaschem") OR (DEFINED CATCHEM_CCPP_PROCESS AND (CATCHEM_CCPP_PROCESS STREQUAL "photolysis" OR CATCHEM_CCPP_PROCESS STREQUAL "gaschem")))
+  enable_language(CXX)
+endif()
+if(DEFINED CATCHEM_CCPP_PROCESSES)
+  set(_catchem_process_list ${CATCHEM_CCPP_PROCESSES})
+elseif(DEFINED CATCHEM_CCPP_PROCESS)
+  set(_catchem_process_list ${CATCHEM_CCPP_PROCESS})
+endif()
+if(DEFINED _catchem_process_list)
+  foreach(_catchem_process IN LISTS _catchem_process_list)
+    if(NOT _catchem_process MATCHES "^(dust|seasalt|drydep|wetdep|settling|so4chem|carbchem|photolysis|gaschem)$")
+      message(FATAL_ERROR "Unsupported CATChem process '${_catchem_process}'")
+    endif()
+  endforeach()
+endif()
 add_subdirectory(ccpp)
 add_subdirectory(scm/src)
+
+# Optional CATChem process integration is enabled by the explicit
+# acceptance runner. CCPP host modules come from scm-ccpp's usage
+# requirements, and the host executable links the adapter and CATChem targets.
+if(DEFINED _catchem_process_list)
+  if(NOT CATCHEM_SOURCE_DIR OR NOT EXISTS "${CATCHEM_SOURCE_DIR}/CMakeLists.txt")
+    message(FATAL_ERROR "CATCHEM_SOURCE_DIR must point to the CATChem checkout")
+  endif()
+  set(CATCHEM_BUILD_CCPP ON CACHE BOOL "Build CATChem's CCPP adapter" FORCE)
+  set(CATCHEM_BUILD_TESTING OFF CACHE BOOL "Disable nested CATChem tests" FORCE)
+  set(CATCHEM_CCPP_HOST_MODULE_DIR "${CMAKE_BINARY_DIR}/ccpp/include" CACHE PATH
+      "SCM generated and host Fortran modules" FORCE)
+  file(MAKE_DIRECTORY "${CATCHEM_CCPP_HOST_MODULE_DIR}")
+  set(CATCHEM_CCPP_HOST_TARGET scm-ccpp CACHE STRING "SCM CCPP module and library target" FORCE)
+  set(_scm_fortran_flags "${CMAKE_Fortran_FLAGS}")
+  string(REPLACE "-fdefault-real-8" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
+  string(REPLACE "-fdefault-double-8" "" CMAKE_Fortran_FLAGS "${CMAKE_Fortran_FLAGS}")
+  add_subdirectory("${CATCHEM_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/catchem")
+  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/catchem/src/external/musica/mod_fortran")
+  # SCM enables the DEBUG preprocessor macro globally; TUV-x has a Fortran
+  # variable with the same name, so undefine it only for the TUV-x sources.
+  if((CATCHEM_BUILD_MUSICA OR "photolysis" IN_LIST _catchem_process_list OR "gaschem" IN_LIST _catchem_process_list) AND TARGET tuvx_object)
+    target_compile_options(tuvx_object PRIVATE -UDEBUG)
+    set(_catchem_tuvx_mod_dir "${CMAKE_BINARY_DIR}/tuvx-modules")
+    file(MAKE_DIRECTORY "${_catchem_tuvx_mod_dir}")
+    set_target_properties(tuvx_object PROPERTIES Fortran_MODULE_DIRECTORY "${_catchem_tuvx_mod_dir}")
+    target_include_directories(tuvx_object PUBLIC "$<BUILD_INTERFACE:${_catchem_tuvx_mod_dir}>")
+    if(TARGET musica)
+      target_include_directories(musica PRIVATE "${_catchem_tuvx_mod_dir}")
+      add_dependencies(musica tuvx_object)
+    endif()
+  endif()
+  set(CMAKE_Fortran_FLAGS "${_scm_fortran_flags}")
+  add_dependencies(scm-ccpp CATChem)
+  target_link_libraries(scm-ccpp CATChem)
+  add_dependencies(CCPP_CATChem_interface scm-ccpp)
+  target_sources(scm-ccpp PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/ccpp/framework/capgen/src/ccpp_hashable.F90"
+    "${CMAKE_CURRENT_SOURCE_DIR}/ccpp/framework/capgen/src/ccpp_hash_table.F90"
+    "${CMAKE_CURRENT_SOURCE_DIR}/ccpp/framework/capgen/src/ccpp_constituent_prop_mod.F90")
+  target_link_libraries(CCPP_CATChem_interface PUBLIC scm-ccpp)
+  target_link_libraries(scm CCPP_CATChem_interface)
+  target_link_libraries(scm stdc++)
+  target_link_options(scm PRIVATE -Wl,--no-as-needed)
+  target_include_directories(scm PRIVATE "${CMAKE_BINARY_DIR}/catchem/include")
+  add_dependencies(scm CCPP_CATChem_interface)
+  if(NOT TARGET CCPP_CATChem_interface)
+    message(FATAL_ERROR "CATChem CCPP interface target was not created")
+  endif()
+  file(GLOB_RECURSE _catchem_generated_caps "${CMAKE_BINARY_DIR}/ccpp/*cap.F90")
+  foreach(_catchem_process IN LISTS _catchem_process_list)
+    if(NOT EXISTS "${CATCHEM_SOURCE_DIR}/drivers/ccpp/catchem_${_catchem_process}.meta")
+      message(FATAL_ERROR "CATChem CCPP metadata is missing for ${_catchem_process}")
+    endif()
+    set(_catchem_process_cap_found FALSE)
+    foreach(_catchem_cap IN LISTS _catchem_generated_caps)
+      file(READ "${_catchem_cap}" _catchem_cap_source)
+      string(FIND "${_catchem_cap_source}" "catchem_${_catchem_process}_driver_run" _catchem_run_call)
+      if(NOT _catchem_run_call EQUAL -1)
+        set(_catchem_process_cap_found TRUE)
+      endif()
+    endforeach()
+    if(NOT _catchem_process_cap_found)
+      message(FATAL_ERROR "CCPP generated no cap calling catchem_${_catchem_process}_driver_run")
+    endif()
+  endforeach()
+  string(JOIN "," _catchem_process_names ${_catchem_process_list})
+  file(WRITE "${CMAKE_BINARY_DIR}/CATCHEM_CCPP_CAP_READY" "${_catchem_process_names}\n")
+endif()
