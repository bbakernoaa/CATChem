+!> Return the Gregorian ordinal day for the SCM host clock.
+!! @param year Four-digit calendar year.
+!! @param month Calendar month in the range 1 through 12.
+!! @param day Day of month.
+pure integer function catchem_ordinal_day(year, month, day)
+  integer, intent(in) :: year, month, day
+  integer :: month_index
+  integer :: month_lengths(12)
+  month_lengths = [31,28,31,30,31,30,31,31,30,31,30,31]
+  if (mod(year,4) == 0 .and. (mod(year,100) /= 0 .or. mod(year,400) == 0)) month_lengths(2) = 29
+  catchem_ordinal_day = day
+  do month_index = 1, month - 1
+    if (month_index >= 1 .and. month_index <= 12) catchem_ordinal_day = catchem_ordinal_day + month_lengths(month_index)
+  end do
+end function catchem_ordinal_day
+
+!> Copy the current SCM tracer state into the framework-owned CCPP constituent array.
+!! Species are matched by the CCPP constituent diagnostic name and SCM tracer name.
+!! Constituents without an SCM tracer keep their framework-owned values.
+!! @param tracer_values SCM qgrs array in (column, layer, tracer) order.
+!! @param tracer_names SCM tracer names in the final qgrs dimension order.
+!! @param errmsg Actionable error detail when the array binding is invalid.
+!! @param errflg Zero on success; nonzero on a property or shape failure.
+subroutine catchem_sync_tracers_to_constituents(tracer_values, tracer_names, errmsg, errflg)
+  real(kind=kind_phys), intent(inout) :: tracer_values(:,:,:)
+  character(len=*), intent(in) :: tracer_names(:)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  call catchem_sync_constituents(tracer_values, tracer_names, .true., errmsg, errflg)
+  if (errflg /= 0) return
+  if (.not. catchem_acceptance_aerosols_seeded) then
+    call catchem_seed_acceptance_aerosols(errmsg, errflg)
+    if (errflg /= 0) return
+    catchem_acceptance_aerosols_seeded = .true.
+  end if
+end subroutine catchem_sync_tracers_to_constituents
+
+!> Seed declared aerosol constituents for a case-specific nonzero SCM acceptance fixture.
+!! The seed is opt-in and is supplied by the case manifests;
+!! it never changes ordinary SCM runs. The CCPP array remains authoritative.
+!! @param errmsg Actionable detail if the environment or framework registry is invalid.
+!! @param errflg Zero on success; nonzero on malformed property access.
+subroutine catchem_seed_acceptance_aerosols(errmsg, errflg)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  type(ccpp_constituent_prop_ptr_t), pointer :: properties(:)
+  real(kind=kind_phys), pointer :: constituents(:,:,:)
+  character(len=32) :: seed_text
+  character(len=256) :: species_name, property_message
+  integer :: environment_status, property_status, constituent_index, i
+  real(kind=kind_phys) :: seed_value
+  errmsg = ''
+  errflg = 0
+  properties => ccpp_model_const_properties()
+  constituents => ccpp_constituents_array()
+  if (.not. associated(properties) .or. .not. associated(constituents)) then
+    errmsg = 'Cannot seed acceptance constituents before CCPP constituent registration.'
+    errflg = 1
+    return
+  end if
+  call get_environment_variable('CATCHEM_ACCEPTANCE_AEROSOL_MIXING_RATIO', seed_text, status=environment_status)
+  if (environment_status == 0 .and. len_trim(seed_text) > 0) then
+    read(seed_text, *, iostat=environment_status) seed_value
+    if (environment_status /= 0 .or. .not. ieee_is_finite(seed_value) .or. seed_value <= 0.0_kind_phys) then
+      errmsg = 'CATCHEM_ACCEPTANCE_AEROSOL_MIXING_RATIO must be a finite positive numeric kg kg-1 value.'
+      errflg = 1
+      return
+    end if
+    do i = 1, size(properties)
+    call properties(i)%diagnostic_name(species_name, property_status, property_message)
+    if (property_status /= 0) then
+      errmsg = 'Unable to inspect an acceptance constituent: '//trim(property_message)
+      errflg = property_status
+      return
+    end if
+    if (.not. catchem_is_acceptance_aerosol(species_name)) cycle
+    call properties(i)%const_index(constituent_index, property_status, property_message)
+    if (property_status /= 0 .or. constituent_index < 1 .or. constituent_index > size(constituents,3)) then
+      errmsg = 'Acceptance aerosol has an invalid CCPP array index: '//trim(species_name)
+      errflg = max(1,property_status)
+      return
+    end if
+    constituents(:,:,constituent_index) = seed_value
+    write(*,'(a,a,a,es14.6,a)') 'CATCHEM_ACCEPTANCE_SEED name=',trim(species_name), &
+      ' VALUE=',real(seed_value,kind=kind_phys),' UNITS=kg kg-1'
+    end do
+  end if
+  call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_SO2_PPMV','so2',properties,constituents,errmsg,errflg)
+  if (errflg /= 0) return
+  call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_DMS_PPMV','dms',properties,constituents,errmsg,errflg)
+  if (errflg /= 0) return
+  call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_H2O2_PPMV','h2o2',properties,constituents,errmsg,errflg)
+  if (errflg /= 0) return
+  call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_OH_PPMV','oh',properties,constituents,errmsg,errflg)
+  if (errflg /= 0) return
+  call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_NO3_PPMV','no3',properties,constituents,errmsg,errflg)
+  if (errflg /= 0) return
+  call get_environment_variable('CATCHEM_ACCEPTANCE_O3_PPMV', seed_text, status=environment_status)
+  if (environment_status == 0 .and. len_trim(seed_text) > 0) then
+    call catchem_seed_acceptance_gas('CATCHEM_ACCEPTANCE_O3_PPMV','o3',properties,constituents,errmsg,errflg)
+    if (errflg /= 0) return
+  end if
+  call get_environment_variable('CATCHEM_ACCEPTANCE_O3_USE_SCM_PROFILE', seed_text, status=environment_status)
+  if (environment_status == 0 .and. len_trim(seed_text) > 0) then
+    call catchem_verify_scm_ozone_profile(properties,constituents,errmsg,errflg)
+    if (errflg /= 0) return
+  end if
+end subroutine catchem_seed_acceptance_aerosols
+
+!> Seed one explicitly declared gas constituent in ppmv for acceptance.
+!! @param environment_name Name of the opt-in case environment variable.
+!! @param species_name Lowercase CCPP diagnostic species name.
+!! @param properties Full framework property registry.
+!! @param constituents Framework-owned constituent array.
+!! @param errmsg Actionable failure detail.
+!! @param errflg Zero on success.
+subroutine catchem_seed_acceptance_gas(environment_name,species_name,properties,constituents,errmsg,errflg)
+  character(len=*), intent(in) :: environment_name,species_name
+  type(ccpp_constituent_prop_ptr_t), intent(in) :: properties(:)
+  real(kind=kind_phys), intent(inout) :: constituents(:,:,:)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  character(len=32) :: value_text
+  character(len=256) :: name,property_message
+  real(kind=kind_phys) :: value, host_mass_ratio, molecular_weight
+  real(kind=kind_phys), parameter :: dry_air_molecular_weight = 28.97e-3_kind_phys
+  integer :: env_status,property_status,index,i
+  errmsg=''
+  errflg=0
+  call get_environment_variable(environment_name,value_text,status=env_status)
+  if (env_status /= 0 .or. len_trim(value_text)==0) return
+  read(value_text,*,iostat=env_status) value
+  if (env_status /= 0 .or. .not. ieee_is_finite(value) .or. value <= 0.0_kind_phys) then
+    errmsg=trim(environment_name)//' must be a finite positive numeric ppmv value.'
+    errflg=1
+    return
+  end if
+  do i=1,size(properties)
+    call properties(i)%diagnostic_name(name,property_status,property_message)
+    if (property_status /= 0) then
+      errmsg='Unable to inspect gas acceptance constituent: '//trim(property_message)
+      errflg=property_status
+      return
+    end if
+    if (trim(adjustl(name)) /= trim(species_name)) cycle
+    call properties(i)%const_index(index,property_status,property_message)
+    if (property_status /= 0 .or. index < 1 .or. index > size(constituents,3)) then
+      errmsg='Gas acceptance constituent has an invalid CCPP array index: '//trim(species_name)
+      errflg=max(1,property_status)
+      return
+    end if
+    call properties(i)%molar_mass(molecular_weight,property_status,property_message)
+    if (property_status /= 0 .or. molecular_weight <= 0.0_kind_phys) then
+      errmsg='Gas acceptance constituent has invalid molar mass: '//trim(species_name)
+      errflg=max(1,property_status)
+      return
+    end if
+    host_mass_ratio = value * 1.0e-6_kind_phys * molecular_weight / dry_air_molecular_weight
+    constituents(:,:,index)=host_mass_ratio
+    write(*,'(a,a,a,es14.6,a,es14.6,a)') 'CATCHEM_ACCEPTANCE_SEED name=',trim(species_name), &
+      ' VALUE=',real(value,kind=kind_phys),' ppmv HOST_MASS_RATIO=',host_mass_ratio,' kg kg-1'
+    return
+  end do
+  errmsg='Gas acceptance species is not registered: '//trim(species_name)
+  errflg=1
+end subroutine catchem_seed_acceptance_gas
+
+!> Verify and report the SCM-initialized vertical ozone profile in CCPP state.
+!! @param properties Full framework constituent property registry.
+!! @param constituents Framework-owned constituent array.
+!! @param errmsg Actionable error detail when ozone is absent or invalid.
+!! @param errflg Zero on success; nonzero when the profile is not usable.
+subroutine catchem_verify_scm_ozone_profile(properties,constituents,errmsg,errflg)
+  type(ccpp_constituent_prop_ptr_t), intent(in) :: properties(:)
+  real(kind=kind_phys), intent(in) :: constituents(:,:,:)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  character(len=256) :: name,property_message
+  real(kind=kind_phys) :: profile_min,profile_max
+  integer :: i,index,property_status
+  errmsg=''
+  errflg=0
+  do i=1,size(properties)
+    call properties(i)%diagnostic_name(name,property_status,property_message)
+    if (property_status /= 0) then
+      errmsg='Unable to inspect SCM ozone constituent: '//trim(property_message)
+      errflg=property_status
+      return
+    end if
+    if (trim(adjustl(name))/='o3') cycle
+    call properties(i)%const_index(index,property_status,property_message)
+    if (property_status /= 0 .or. index<1 .or. index>size(constituents,3)) then
+      errmsg='SCM ozone profile has an invalid CCPP constituent index.'
+      errflg=max(1,property_status)
+      return
+    end if
+    profile_min=minval(constituents(:,:,index))
+    profile_max=maxval(constituents(:,:,index))
+    write(*,'(a,es14.6,a,es14.6,a,i0)') 'CATCHEM_SCM_O3_PROFILE_CHECK min=',profile_min, &
+      ' max=',profile_max,' levels=',size(constituents,2)
+    if (.not. all(ieee_is_finite(constituents(:,:,index))) .or. profile_min<0.0_kind_phys .or. profile_max<=0.0_kind_phys .or. &
+        profile_max<=profile_min) then
+      errmsg='SCM ozone CCPP constituent must contain a finite nonnegative, vertically varying profile with positive abundance.'
+      errflg=1
+      return
+    end if
+    write(*,'(a,i0,a,es14.6,a,es14.6,a)') 'CATCHEM_SCM_O3_PROFILE levels=',size(constituents,2), &
+      ' MIN_HOST_MASS_RATIO=',profile_min,' MAX_HOST_MASS_RATIO=',profile_max,' kg kg-1'
+    return
+  end do
+  errmsg='SCM ozone profile is not registered in the CCPP constituent array.'
+  errflg=1
+end subroutine catchem_verify_scm_ozone_profile
+
+!> Identify aerosol species included in the compact first-stage SCM fixture.
+!! @param name CCPP constituent diagnostic name.
+!! @return True for aerosol bins, sulfate, MSA, black carbon, or organic carbon.
+pure logical function catchem_is_acceptance_aerosol(name)
+  character(len=*), intent(in) :: name
+  character(len=32) :: key
+  integer :: i, code
+  key = adjustl(name)
+  do i = 1, len_trim(key)
+    code = iachar(key(i:i))
+    if (code >= iachar('A') .and. code <= iachar('Z')) key(i:i) = achar(code+32)
+  end do
+  catchem_is_acceptance_aerosol = index(key,'dust') == 1 .or. index(key,'seas') == 1 .or. &
+    index(key,'so4') == 1 .or. index(key,'msa') == 1 .or. index(key,'bc') == 1 .or. index(key,'oc') == 1
+end function catchem_is_acceptance_aerosol
+
+!> Copy framework-owned CCPP constituent values back into matching SCM tracers.
+!! @param tracer_values SCM qgrs array in (column, layer, tracer) order.
+!! @param tracer_names SCM tracer names in the final qgrs dimension order.
+!! @param errmsg Actionable error detail when the array binding is invalid.
+!! @param errflg Zero on success; nonzero on a property or shape failure.
+subroutine catchem_sync_constituents_to_tracers(tracer_values, tracer_names, errmsg, errflg)
+  real(kind=kind_phys), intent(inout) :: tracer_values(:,:,:)
+  character(len=*), intent(in) :: tracer_names(:)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  call catchem_sync_constituents(tracer_values, tracer_names, .false., errmsg, errflg)
+end subroutine catchem_sync_constituents_to_tracers
+
+!> Seed a deliberately unrelated, nonadvected host constituent for conformance runs.
+!! @param errmsg Actionable error detail when its framework slot cannot be resolved.
+!! @param errflg Zero on success; nonzero on malformed registry access.
+subroutine catchem_seed_acceptance_unrelated(errmsg, errflg)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  real(kind=kind_phys), pointer :: constituents(:,:,:)
+  integer :: status
+  errmsg = ''
+  errflg = 0
+  constituents => ccpp_constituents_array()
+  if (.not. associated(constituents)) then
+    errmsg = 'CCPP constituent storage is unavailable while seeding the unrelated host constituent.'
+    errflg = 1
+    return
+  end if
+  call ccpp_const_get_index(stdname='catchem_acceptance_unrelated_tracer', &
+      const_index=catchem_acceptance_unrelated_index, errcode=status, errmsg=errmsg)
+  if (status /= 0 .or. catchem_acceptance_unrelated_index < 1 .or. &
+      catchem_acceptance_unrelated_index > size(constituents,3)) then
+    errmsg = 'Unrelated acceptance constituent has an invalid CCPP slot: '//trim(errmsg)
+    errflg = max(1,status)
+    return
+  end if
+  catchem_acceptance_unrelated_value = 7.654321e-7_kind_phys
+  constituents(:,:,catchem_acceptance_unrelated_index) = catchem_acceptance_unrelated_value
+  write(*,'(a,i0,a,es14.6)') 'CATCHEM_UNRELATED_SEEDED slot=', &
+    catchem_acceptance_unrelated_index, ' VALUE=', catchem_acceptance_unrelated_value
+end subroutine catchem_seed_acceptance_unrelated
+
+!> Seed a prior host contribution in the unrelated slot before CATChem runs.
+!! @param errmsg Actionable error detail when the tendency array or slot is unavailable.
+!! @param errflg Zero on success; nonzero on invalid framework state.
+subroutine catchem_seed_acceptance_unrelated_tendency(errmsg, errflg)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  errmsg = ''
+  errflg = 0
+  if (.not. allocated(ccpp_model_constituents_obj)) then
+    errmsg = 'CCPP model constituent storage is unavailable while seeding a prior tendency.'
+    errflg = 1
+    return
+  end if
+  if (size(ccpp_model_constituents_obj) /= 1) then
+    errmsg = 'CCPP host updater fixture expects one SCM model constituent instance.'
+    errflg = 1
+    return
+  end if
+  if (.not. allocated(ccpp_model_constituents_obj(1)%vars_layer_tend)) then
+    errmsg = 'CCPP tendency storage is unavailable while seeding a prior contribution.'
+    errflg = 1
+    return
+  end if
+  if (catchem_acceptance_unrelated_index < 1 .or. &
+      catchem_acceptance_unrelated_index > size(ccpp_model_constituents_obj(1)%vars_layer_tend,3)) then
+    errmsg = 'CCPP unrelated constituent index is outside the tendency array extent.'
+    errflg = 1
+    return
+  end if
+  catchem_acceptance_unrelated_tendency_value = 2.468013e-9_kind_phys
+  ccpp_model_constituents_obj(1)%vars_layer_tend(:,:,catchem_acceptance_unrelated_index) = &
+    catchem_acceptance_unrelated_tendency_value
+  write(*,'(a,i0,a,es14.6)') 'CATCHEM_UNRELATED_TENDENCY_SEEDED slot=', &
+    catchem_acceptance_unrelated_index, ' VALUE=', catchem_acceptance_unrelated_tendency_value
+end subroutine catchem_seed_acceptance_unrelated_tendency
+
+!> Require the unrelated host tendency contribution to survive the CATChem host update.
+!! @param errmsg Actionable error detail when another writer changed the seeded value.
+!! @param errflg Zero on success; nonzero when the prior contribution was not preserved.
+subroutine catchem_verify_acceptance_unrelated_tendency(errmsg, errflg)
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  errmsg = ''
+  errflg = 0
+  if (.not. allocated(ccpp_model_constituents_obj)) then
+    errmsg = 'CCPP model constituent storage is unavailable while checking a prior tendency.'
+    errflg = 1
+    return
+  end if
+  if (size(ccpp_model_constituents_obj) /= 1) then
+    errmsg = 'CCPP host updater fixture expects one SCM model constituent instance.'
+    errflg = 1
+    return
+  end if
+  if (.not. allocated(ccpp_model_constituents_obj(1)%vars_layer_tend)) then
+    errmsg = 'CCPP tendency storage was deallocated before the prior-contribution check.'
+    errflg = 1
+    return
+  end if
+  if (any(ccpp_model_constituents_obj(1)%vars_layer_tend(:,:,catchem_acceptance_unrelated_index) /= &
+      catchem_acceptance_unrelated_tendency_value)) then
+    errmsg = 'CATChem changed a preexisting unrelated CCPP constituent tendency.'
+    errflg = 1
+    return
+  end if
+  write(*,'(a,i0,a,es14.6)') 'CATCHEM_UNRELATED_TENDENCY_PRESERVED slot=', &
+    catchem_acceptance_unrelated_index, ' VALUE=', catchem_acceptance_unrelated_tendency_value
+end subroutine catchem_verify_acceptance_unrelated_tendency
+
+!> Synchronize matching species between qgrs and the registered CCPP constituent state.
+!! @param tracer_values SCM qgrs array in (column, layer, tracer) order.
+!! @param tracer_names SCM tracer names in the final qgrs dimension order.
+!! @param to_constituents True imports qgrs; false exports CCPP state to qgrs.
+!! @param errmsg Actionable error detail when the CCPP array or property registry is invalid.
+!! @param errflg Zero on success; nonzero when binding or property lookup fails.
+subroutine catchem_sync_constituents(tracer_values, tracer_names, to_constituents, errmsg, errflg)
+  real(kind=kind_phys), intent(inout) :: tracer_values(:,:,:)
+  character(len=*), intent(in) :: tracer_names(:)
+  logical, intent(in) :: to_constituents
+  character(len=*), intent(out) :: errmsg
+  integer, intent(out) :: errflg
+  type(ccpp_constituent_prop_ptr_t), pointer :: properties(:)
+  real(kind=kind_phys), pointer :: constituents(:,:,:)
+  character(len=256) :: species_name, property_message
+  integer :: property_status, constituent_index, species_index, i
+
+  errmsg = ''
+  errflg = 0
+  constituents => ccpp_constituents_array()
+  properties => ccpp_model_const_properties()
+  if (.not. associated(constituents) .or. .not. associated(properties)) then
+    errmsg = 'CCPP constituent storage or property registry is not initialized.'
+    errflg = 1
+    return
+  end if
+  if (size(tracer_values,1) /= size(constituents,1) .or. &
+      size(tracer_values,2) /= size(constituents,2) .or. &
+      size(tracer_values,3) /= size(tracer_names)) then
+    errmsg = 'SCM tracer and CCPP constituent array extents do not agree.'
+    errflg = 1
+    return
+  end if
+
+  do i = 1, size(properties)
+    call properties(i)%diagnostic_name(species_name, property_status, property_message)
+    if (property_status /= 0) then
+      errmsg = 'Unable to read a registered CCPP constituent diagnostic name: '//trim(property_message)
+      errflg = property_status
+      return
+    end if
+    call properties(i)%const_index(constituent_index, property_status, property_message)
+    if (property_status /= 0 .or. constituent_index < 1 .or. constituent_index > size(constituents,3)) then
+      errmsg = 'A CCPP constituent has an invalid framework index: '//trim(species_name)
+      errflg = max(1, property_status)
+      return
+    end if
+
+    do species_index = 1, size(tracer_names)
+      if (.not. catchem_same_species_name(species_name, tracer_names(species_index))) cycle
+      if (catchem_is_ozone_identifier(species_name) .and. catchem_is_ozone_identifier(tracer_names(species_index))) then
+        write(*,'(a,a,a,a,a,es14.6,a,es14.6)') 'CATCHEM_O3_MAP constituent=',trim(species_name), &
+          ' tracer=',trim(tracer_names(species_index)),' min=',minval(tracer_values(:,:,species_index)), &
+          ' max=',maxval(tracer_values(:,:,species_index))
+      end if
+      if (to_constituents) then
+        constituents(:,:,constituent_index) = tracer_values(:,:,species_index)
+      else
+        tracer_values(:,:,species_index) = constituents(:,:,constituent_index)
+      end if
+      exit
+    end do
+  end do
+  if (.not. to_constituents .and. catchem_acceptance_unrelated_index > 0) then
+    if (any(constituents(:,:,catchem_acceptance_unrelated_index) /= catchem_acceptance_unrelated_value)) then
+      errmsg = 'An unrelated nonadvected CCPP host constituent changed during CATChem execution.'
+      errflg = 1
+      return
+    end if
+    if (.not. catchem_acceptance_unrelated_reported) then
+      write(*,'(a,i0,a,es14.6)') 'CATCHEM_UNRELATED_PRESERVED slot=', &
+        catchem_acceptance_unrelated_index, ' VALUE=', catchem_acceptance_unrelated_value
+      catchem_acceptance_unrelated_reported = .true.
+    end if
+  end if
+end subroutine catchem_sync_constituents
+
+!> Compare species identifiers without depending on the case used by SCM or CATChem.
+!! @param left First species identifier.
+!! @param right Second species identifier.
+!! @return True when trimmed identifiers match case-insensitively.
+logical function catchem_same_species_name(left, right)
+  character(len=*), intent(in) :: left, right
+  integer :: i, left_char, right_char
+  catchem_same_species_name = .false.
+  if (catchem_is_ozone_identifier(left) .and. catchem_is_ozone_identifier(right)) then
+    catchem_same_species_name = .true.
+    return
+  end if
+  if (len_trim(left) /= len_trim(right)) return
+  do i = 1, len_trim(left)
+    left_char = iachar(left(i:i))
+    right_char = iachar(right(i:i))
+    if (left_char >= iachar('a') .and. left_char <= iachar('z')) left_char = left_char - 32
+    if (right_char >= iachar('a') .and. right_char <= iachar('z')) right_char = right_char - 32
+    if (left_char /= right_char) return
+  end do
+  catchem_same_species_name = .true.
+end function catchem_same_species_name
+
+!> Recognize CATChem O3 and GFS SCM ozone tracer identifiers as aliases.
+!! @param name Constituent or tracer identifier.
+!! @return True for CCPP O3, GFS tracer o3mr, or ozone_mixing_ratio.
+pure logical function catchem_is_ozone_identifier(name)
+  character(len=*), intent(in) :: name
+  character(len=32) :: key
+  integer :: i, code
+  key=adjustl(name)
+  do i=1,len_trim(key)
+    code=iachar(key(i:i))
