+# The SCM host sources are already present in the capgen dependency closure.
+# Drop their metadata-derived lower-case copies to avoid compiling the same
+# Fortran modules twice (e.g., GFS_typedefs.F90 and GFS_typedefs.f90).
+set(_scm_existing_sources ${CAPGEN_DEPENDENCIES} ${SCHEME_FORTRAN_FILES} ${CAPGEN_FILES})
+foreach(_host_source IN LISTS HOST_FORTRAN_FILES)
+  get_filename_component(_host_stem "${_host_source}" NAME_WE)
+  string(TOLOWER "${_host_stem}" _host_stem_lower)
+  foreach(_existing_source IN LISTS _scm_existing_sources)
+    get_filename_component(_existing_stem "${_existing_source}" NAME_WE)
+    string(TOLOWER "${_existing_stem}" _existing_stem_lower)
+    if(_host_stem_lower STREQUAL _existing_stem_lower)
+      list(REMOVE_ITEM HOST_FORTRAN_FILES "${_host_source}")
+      break()
+    endif()
+  endforeach()
+endforeach()
+list(REMOVE_ITEM HOST_FORTRAN_FILES
+  "${HOST_FILES_DIR}/CCPP_typedefs.f90"
+  "${HOST_FILES_DIR}/GFS_typedefs.f90")
+
 message(STATUS "List of capgen dependencies: ${CAPGEN_DEPENDENCIES}")
 message(STATUS "List of filtered scheme files: ${SCHEME_FORTRAN_FILES}")
 message(STATUS "List of capgen-generated files: ${CAPGEN_FILES}")
