+set(SCHEME_FILES constituent_probe)
+set(HOST_FILES probe_host_data probe_host)
+set(HOST_METADATA_FILES probe_host.meta)
+set(SUITE_FILES constituent_probe_suite.xml)
+set(HOST probe_host)
+set(OUTPUT_ROOT "${CMAKE_CURRENT_BINARY_DIR}/ccpp")
+list(TRANSFORM SCHEME_FILES APPEND ".F90" OUTPUT_VARIABLE SCHEME_FORTRAN_FILES)
+list(TRANSFORM SCHEME_FILES APPEND ".meta" OUTPUT_VARIABLE SCHEME_METADATA_FILES)
+list(TRANSFORM HOST_FILES APPEND ".F90" OUTPUT_VARIABLE HOST_FORTRAN_FILES)
+ccpp_validator(VERBOSITY ${CCPP_VERBOSITY} SOURCE_FILES ${SCHEME_FORTRAN_FILES}
+               METADATA_FILES ${SCHEME_METADATA_FILES} TYPE SCHEME)
+ccpp_validator(VERBOSITY ${CCPP_VERBOSITY} SOURCE_FILES ${HOST_FORTRAN_FILES}
+               METADATA_FILES ${HOST_METADATA_FILES} TYPE HOST)
+ccpp_capgen(VERBOSITY ${CCPP_VERBOSITY} HOSTFILES ${HOST_METADATA_FILES}
+            SCHEMEFILES ${SCHEME_METADATA_FILES} SUITES ${SUITE_FILES}
+            HOST_NAME ${HOST} OUTPUT_ROOT "${OUTPUT_ROOT}")
+ccpp_datafile(DATATABLE "${OUTPUT_ROOT}/datatable.xml" REPORT_NAME "--dependencies")
+set(CAPGEN_DEPENDENCIES ${CCPP_FILES})
+ccpp_datafile(DATATABLE "${OUTPUT_ROOT}/datatable.xml" REPORT_NAME "--scheme-files")
+set(SCHEME_FORTRAN_FILES_FILTERED ${CCPP_FILES})
+ccpp_datafile(DATATABLE "${OUTPUT_ROOT}/datatable.xml" REPORT_NAME "--capgen-files")
+set(CAPGEN_FILES ${CCPP_FILES})
+set(PROBE_MODULE_DIR "${CMAKE_CURRENT_BINARY_DIR}/modules")
+file(MAKE_DIRECTORY "${PROBE_MODULE_DIR}")
+set(PROBE_BASE_CAPGEN_FILES ${CAPGEN_FILES})
+list(REMOVE_ITEM PROBE_BASE_CAPGEN_FILES
+  "${OUTPUT_ROOT}/probe_host_ccpp_cap.F90"
+  "${OUTPUT_ROOT}/ccpp_constituent_probe_suite_cap.F90")
+
+# Keep generated Fortran module layers in separate targets.  This avoids a
+# GNU Make dependency cycle between the suite dispatcher and its group cap.
+add_library(constituent_probe_base OBJECT ${CAPGEN_DEPENDENCIES}
+  ${SCHEME_FORTRAN_FILES_FILTERED} probe_host_data.F90
+  ${PROBE_BASE_CAPGEN_FILES})
+set_target_properties(constituent_probe_base PROPERTIES
+  Fortran_MODULE_DIRECTORY "${PROBE_MODULE_DIR}")
+target_include_directories(constituent_probe_base PRIVATE "${PROBE_MODULE_DIR}")
+
+add_library(constituent_probe_suite OBJECT
+  "${OUTPUT_ROOT}/ccpp_constituent_probe_suite_cap.F90")
+set_target_properties(constituent_probe_suite PROPERTIES
+  Fortran_MODULE_DIRECTORY "${PROBE_MODULE_DIR}")
+target_include_directories(constituent_probe_suite PRIVATE "${PROBE_MODULE_DIR}")
+add_dependencies(constituent_probe_suite constituent_probe_base)
+
+add_executable(test_constituent_probe.x
+  "${OUTPUT_ROOT}/probe_host_ccpp_cap.F90" probe_host.F90)
+set_target_properties(test_constituent_probe.x PROPERTIES
+  LINKER_LANGUAGE Fortran Fortran_MODULE_DIRECTORY "${PROBE_MODULE_DIR}")
+target_include_directories(test_constituent_probe.x PRIVATE "${PROBE_MODULE_DIR}")
+add_dependencies(test_constituent_probe.x constituent_probe_suite)
+target_link_libraries(test_constituent_probe.x PRIVATE
+  constituent_probe_base constituent_probe_suite MPI::MPI_Fortran)
+target_link_libraries(test_constituent_probe.x PRIVATE MPI::MPI_Fortran)
+if(OPENMP)
+  target_link_libraries(test_constituent_probe.x PRIVATE OpenMP::OpenMP_Fortran)
+endif()
+add_test(NAME test_constituent_probe COMMAND test_constituent_probe.x)
diff --git a/end-to-end-tests/constituent_probe/constituent_probe.F90 b/end-to-end-tests/constituent_probe/constituent_probe.F90
