{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catchem.example/schemas/ccpp-case-acceptance-1.json",
  "title": "CATChem CCPP case acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "processes", "inputs", "outputs", "reference", "budgets", "frozen_before_candidate_comparison"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "processes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dust", "seasalt", "drydep", "wetdep", "settling", "so4chem", "carbchem", "photolysis", "gaschem"]}},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["name", "units", "basis"], "properties": {"name": {"type": "string"}, "units": {"type": "string"}, "basis": {"type": "string"}}, "additionalProperties": false}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "units", "basis", "must_be_nonzero"], "properties": {"name": {"type": "string"}, "units": {"type": "string"}, "basis": {"type": "string"}, "must_be_nonzero": {"type": "boolean"}}, "additionalProperties": false}},
    "reference": {"type": "object", "required": ["method", "description", "source_revision"], "properties": {"method": {"enum": ["analytic", "independent_science", "native_parity", "stock_scm", "same_boundary_process_composition", "pending_native_parity"]}, "description": {"type": "string", "minLength": 1}, "source_revision": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false},
    "tolerances": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["quantity", "absolute", "relative", "rationale"], "properties": {"quantity": {"type": "string"}, "absolute": {"type": "number", "minimum": 0}, "relative": {"type": "number", "minimum": 0}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "budgets": {"type": "array", "items": {"type": "object", "required": ["quantity", "equation", "units", "basis", "residual_tolerance", "rationale"], "properties": {"quantity": {"type": "string"}, "equation": {"type": "string"}, "units": {"type": "string"}, "basis": {"type": "string"}, "residual_tolerance": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "to_be_measured"}]}, "rationale": {"type": "string"}}, "additionalProperties": false}},
    "tolerances": {"type": "array", "items": {"type": "object", "required": ["quantity", "absolute", "relative", "rationale"], "properties": {"quantity": {"type": "string"}, "absolute": {"type": "number", "minimum": 0}, "relative": {"type": "number", "minimum": 0}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "frozen_before_candidate_comparison": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"reference": {"properties": {"method": {"const": "native_parity"}}}}},
      "then": {"properties": {"reference": {"required": ["evidence"]}}}
    },
    {
      "if": {"properties": {"reference": {"properties": {"method": {"const": "pending_native_parity"}}}}},
      "then": {"properties": {"frozen_before_candidate_comparison": {"const": false}}},
      "else": {"properties": {"frozen_before_candidate_comparison": {"const": true}}}
    }
  ]
}
